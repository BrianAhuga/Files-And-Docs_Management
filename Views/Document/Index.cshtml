@model IEnumerable<DocumentUploader_MVCCore.Models.Document>

@{
    ViewData["Title"] = "Documents";
}

<div class="upload-button-container">
    <a asp-controller="Document" asp-action="Upload" class="btn btn-outline-success">
        Upload New Document
    </a>
</div>
<hr />
<h2>Uploaded Documents</h2>

<div class="document-list">
    @foreach (var doc in Model)
    {
        <div class="document-card">
            <h4>@doc.FileName</h4>

            @if (doc.DocumentType == "PDF")
            {
                <iframe src="@Url.Action("ViewDocument", "Document", new { id = doc.Id })" width="100%" height="500px"></iframe>
            }
            else if (doc.DocumentType == "Text")
            {
                <pre>@System.Text.Encoding.UTF8.GetString(doc.Data)</pre>
            }
            else if (doc.DocumentType == "Image")
            {
                <img src="@Url.Action("ViewDocument", "Document", new { id = doc.Id })" alt="@doc.FileName" style="max-width:100%; height:auto;" />
            }
            else
            {
                <p>Cannot preview this document type. You can download it using the download button below.</p>
            }

            <div class="document-actions">
                <a href="@Url.Action("ViewDocument", "Document", new { id = doc.Id })" target="_blank" class="open-button" style="margin-right: 20px;">
                    Open Document
                </a>

                <a href="@Url.Action("Download", "Document", new { id = doc.Id })" class="download-button">
                    Download Document
                </a>
            </div>
        </div>
    }
</div>

<link href="~/css/indexview.css" rel="stylesheet" />